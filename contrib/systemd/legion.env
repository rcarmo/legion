# Install as /etc/legion/legion.env, mode 0600.
# Do not commit real credentials.
# LEGION_API_KEY=replace-with-a-long-random-token
# LEGION_NAMESPACE_CAPABILITY=replace-with-an-independent-long-random-token
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LEGION_BUN_BIN=/usr/local/bin/bun
# LEGION_INVOKE_TIMEOUT_MS=30000
# LEGION_INVOKE_MAX_INPUT_BYTES=1048576
# LEGION_INVOKE_MAX_OUTPUT_BYTES=4194304
# LEGION_INVOKE_MAX_CONCURRENT_PER_FUNCTION=8
# LEGION_INVOKE_MAX_REQUESTS_PER_WINDOW=120
# LEGION_INVOKE_RATE_WINDOW_MS=60000
# LEGION_SESSION_MAX_REQUESTS_PER_WINDOW=30
# LEGION_SESSION_RATE_WINDOW_MS=60000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.example:4318
